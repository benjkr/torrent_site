{
  "name": "torrent-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run ./scripts/dev.ts",
    "dev:app": "bun --env-file=.env.development x react-router dev",
    "dev:ws": "bun --env-file=.env.development run ./scripts/maindata-ws.ts",
    "build": "react-router build",
    "start": "bun --env-file=.env.production run server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@ctrl/qbittorrent": "^9.14.0",
    "@react-router/node": "^7.5.0",
    "@tailwindcss/vite": "^4.3.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "isbot": "^5.1.17",
    "lucide-react": "^1.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "5.7.0",
    "react-router": "^7.5.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.10.6",
    "@react-router/dev": "^7.5.0",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "1.3.14",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "shadcn": "^4.13.0",
    "typescript": "7",
    "vite": "^6.3.5"
  }
}
