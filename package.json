{
  "name": "torrent-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run ./scripts/dev.ts",
    "dev:app": "bun --env-file=.env.development --conditions=development ./node_modules/@react-router/dev/bin.cjs dev",
    "dev:ws": "bun --env-file=.env.development run ./scripts/maindata-ws.ts",
    "build": "react-router build",
    "start": "bun --env-file=.env.production run server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@ctrl/qbittorrent": "^9.14.0",
    "@react-router/node": "^8.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "isbot": "^5.2.1",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "5.7.0",
    "react-router": "^8.3.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.1",
    "@react-router/dev": "^8.3.0",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "1.3.14",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "shadcn": "^4.16.0",
    "typescript": "7",
    "vite": "^8.1.5"
  }
}
