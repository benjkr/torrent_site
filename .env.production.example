# Copy to .env.production and fill in real values. Never commit .env.production.
NODE_ENV=production
QB_BASE_URL=http://your-qbittorrent-host:8080/
QB_USERNAME=
QB_PASSWORD=

# App container sees the download library at /downloads (same as qB).
LIBRARY_FILES_ROOT=/downloads
LIBRARY_FILES_QB_PREFIX=/downloads
# Host path of the qB downloads volume — publish.sh bind-mounts this to /downloads.
# Use the same host directory that is mounted into the qBittorrent container.
QB_DOWNLOADS_HOST_PATH=/path/on/host/to/qb/downloads

# GitHub PAT (or token) with packages:read/write for ghcr.io — used by publish.sh
GH_TOKEN=
